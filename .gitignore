# Entorno virtual
.venv/

# Bytecode
__pycache__/
*.py[cod]

# Variables de entorno: nunca versionar credenciales
.env
.env.*
# .env.demo es la plantilla con placeholders: esa si se versiona
!.env.demo
# .env.example es la plantilla con placeholders: esa si se versiona
!.env.example

# Pytest
.pytest_cache/

# agent-baseline: respaldos de reinstalacion
.baseline-backup/

# agent-baseline: adaptadores de descubrimiento (generados)
.agents/skills/
.clinerules/
.claude/skills/
.kilocode/
